#!/bin/sh

# PROVIDE: dnssec_validator
# REQUIRE: NETWORKING
# KEYWORD: shutdown

. /etc/rc.subr

name="dnssec_validator"
rcvar="dnssec_validator_enable"

load_rc_config "$name"

: ${dnssec_validator_enable:="NO"}
: ${dnssec_validator_user:="www"}
: ${dnssec_validator_group:="www"}
: ${dnssec_validator_chdir:="/usr/local/www/dnssec-validator"}
: ${dnssec_validator_node:="/usr/local/bin/node"}
: ${dnssec_validator_script:="dnssec-validator.js"}
: ${dnssec_validator_pidfile:="/var/run/${name}.pid"}
: ${dnssec_validator_log:="/var/log/${name}.log"}

pidfile="${dnssec_validator_pidfile}"
command="/usr/sbin/daemon"
command_args="-f -p ${pidfile} -u ${dnssec_validator_user} -o ${dnssec_validator_log} ${dnssec_validator_node} ${dnssec_validator_script}"
start_precmd="${name}_prestart"

dnssec_validator_prestart()
{
    if [ ! -d "${dnssec_validator_chdir}" ]; then
        err 1 "dnssec_validator_chdir does not exist: ${dnssec_validator_chdir}"
    fi
    if [ ! -x "${dnssec_validator_node}" ]; then
        err 1 "dnssec_validator_node is not executable: ${dnssec_validator_node}"
    fi
    if [ ! -f "${dnssec_validator_chdir}/${dnssec_validator_script}" ]; then
        err 1 "dnssec_validator_script does not exist: ${dnssec_validator_chdir}/${dnssec_validator_script}"
    fi
    install -d -o "${dnssec_validator_user}" -g "${dnssec_validator_group}" -m 0755 "$(dirname "${pidfile}")"
    touch "${dnssec_validator_log}"
    chown "${dnssec_validator_user}:${dnssec_validator_group}" "${dnssec_validator_log}"
}

run_rc_command "$1"
